# Normalize all text to LF in the repo and in the working tree.
# Unity on Windows is fine with LF, and this prevents the CRLF churn
# (and full shader recompiles) described in "future plan/04".
* text=auto eol=lf

# Windows scripts genuinely need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unity YAML/text assets
*.meta text
*.unity text
*.asset text
*.prefab text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.physicsMaterial2D text
*.playable text
*.mask text
*.brush text
*.flare text
*.fontsettings text
*.guiskin text
*.giparams text
*.renderTexture text
*.spriteatlas text
*.terrainlayer text
*.mixer text
*.shadervariants text
*.preset text
